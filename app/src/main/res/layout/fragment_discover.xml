<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_dark"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:id="@+id/tvDiscoverTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Discover"
        android:textColor="@color/text_primary"
        android:textSize="28sp"
        android:fontFamily="sans-serif-black" />

    <TextView
        android:id="@+id/tvDiscoverSubtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Swipe to connect with people"
        android:textColor="@color/text_tertiary"
        android:textSize="13sp" />

    <FrameLayout
        android:id="@+id/discoverCard"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="20dp"
        android:background="@drawable/bg_glass_hero"
        android:padding="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/ivProfilePhoto"
                android:layout_width="92dp"
                android:layout_height="92dp"
                android:layout_gravity="center_horizontal"
                android:src="@drawable/ic_heart"
                android:background="@drawable/bg_emoji_circle"
                android:padding="18dp"
                android:contentDescription="@string/profile" />

            <TextView
                android:id="@+id/tvCandidateName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center"
                android:textColor="@color/text_primary"
                android:textSize="24sp"
                android:textStyle="bold"
                android:text="Loading..." />

            <TextView
                android:id="@+id/tvCandidateBio"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center"
                android:textColor="@color/text_secondary"
                android:textSize="15sp"
                android:text="Your next match might be here." />

            <TextView
                android:id="@+id/tvDiscoverEmpty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:gravity="center"
                android:text="No more discoverable users right now."
                android:textColor="@color/text_tertiary"
                android:textSize="12sp"
                android:visibility="gone" />
        </LinearLayout>
    </FrameLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="center"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPass"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:text="Pass"
            android:textAllCaps="false"
            android:layout_marginEnd="8dp"
            style="@style/Widget.Gzmy.Button.Outlined" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnLike"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:text="Like"
            android:textAllCaps="false"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_gradient_pill"
            app:backgroundTint="@null" />
    </LinearLayout>

</LinearLayout>
